# ─── Database (PostgreSQL Connection) ──────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_NAME=fashion_jewellery_db

# ─── Server Configuration ─────────────────────────────────
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173

# ─── Authentication Configuration ─────────────────────────
JWT_SECRET=your_jwt_signing_secret_key
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=12

# ─── Static Administrative Credentials ─────────────────────
# These environment variables configure the direct master admin user
ADMIN_EMAIL=admin@jewellery.com
ADMIN_PASSWORD_HASH=$2b$12$ArJwVJYWmQsFUOYHzgqdmOyanWoyDy5.hj.fvg34SEzwC44F8nQnS
ADMIN_NAME=System Admin

# ─── n8n Workflow & Automation Integration ────────────────
# URL of your n8n webhook node that triggers Instagram post generation
N8N_POST_WEBHOOK_URL=http://localhost:5678/webhook/generate-instagram-post

# URL of your n8n resume webhook / wait node that unpauses after approval
N8N_RESUME_WEBHOOK_URL=http://localhost:5678/webhook/resume-instagram-approval

# Shared secret sent in x-webhook-secret header between application and n8n
N8N_WEBHOOK_SECRET=your_secure_n8n_webhook_secret_key

# Public or local base URL of this application backend (used by n8n callbacks and Gmail links)
APP_BASE_URL=http://localhost:5000

# ─── Cloudinary Image Storage Configuration ───────────────
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET

